{
  "$comment": "Checked-in Claude Code settings for this repository. Hooks, plus the one permissions rule that is not a personal choice: the deny list keeps agent sessions from writing to the dogfood knowledge base through the CLI, which the dev instance would record as the anonymous human — agent writes go through the ochakai MCP tools, whose connection carries the process identity (kb/bundle/policies/ai-human-identity.md). Everything else about permissions belongs in the untracked settings.local.json.",
  "permissions": {
    "deny": [
      "Bash(ochakai put:*)",
      "Bash(ochakai verify:*)",
      "Bash(ochakai delete:*)",
      "Bash(ochakai purge:*)",
      "Bash(ochakai move:*)",
      "Bash(ochakai reembed:*)",
      "Bash(ochakai import:*)",
      "Bash(ochakai report:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 180
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ochakai-recall.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gofmt.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ochakai-write-back.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
